# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Database
DATABASE_URL=postgresql+asyncpg://supportpilot:supportpilot@db:5432/supportpilot

# Agent guardrails
MAX_STEPS=8
MAX_TOOL_ERRORS=3
REQUEST_TIMEOUT_S=60

# Admin
ADMIN_PASSWORD=change-me

# Mock external APIs (chaos injection)
MOCK_LATENCY_MS=0
MOCK_FAILURE_RATE=0.0
MOCK_BASE_URL=http://127.0.0.1:8000

# Optional webhook for handoff / booking events
WEBHOOK_URL=

# Frontend (browser calls backend on the host)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
